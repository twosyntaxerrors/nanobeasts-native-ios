<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Nanobeasts</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.twosyntaxerrors.nanobeasts.native</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nanobeasts</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Aldrich_400Regular.ttf</string>
		<string>PressStart2P_400Regular.ttf</string>
		<string>SpaceMono_400Regular.ttf</string>
		<string>SpaceMono_700Bold.ttf</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Nanobeasts reads your steps to hatch and evolve your creatures, and can import your workouts and recorded routes from Apple Health for your history and sharing.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Nanobeasts saves completed workouts, distance, and active energy to Apple Health when you allow it.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nanobeasts uses your location during outdoor workouts to measure distance and draw your route.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>WorkoutRoute</key>
		<string>Precise location keeps your workout route accurate and clears fog only where you actually traveled.</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Nanobeasts uses the camera so you can add a finish-line photo to your workout share card.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the achievements, workout photos, and route videos you choose to your photo library.</string>
	<key>NSMotionUsageDescription</key>
	<string>Nanobeasts uses your iPhone motion data to count steps when Apple Health is not connected.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_PUBLIC_SDK_KEY)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
