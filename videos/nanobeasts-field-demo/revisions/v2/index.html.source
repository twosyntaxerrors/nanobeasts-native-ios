<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=1080, height=1666">
<title>Nanobeasts · Field Demo</title>
<script src="assets/gsap.min.js"></script>
<style>
@font-face{font-family:NanoDisplay;src:url('assets/SF-Pro-Display-Bold.otf')}@font-face{font-family:NanoText;src:url('assets/SF-Pro-Text-Regular.otf')}@font-face{font-family:Aldrich;src:url('assets/Aldrich.ttf')}@font-face{font-family:SpaceMono;src:url('assets/SpaceMono-Bold.ttf')}
:root{--bg:#09090b;--surface:#18181b;--ink:#f6faf9;--muted:#a1a1aa;--teal:#59e5d3;--cyan:#19cbe5}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:NanoText}#root{position:relative;width:1080px;height:1666px;overflow:hidden}.ground{position:absolute;inset:0;background:#09090b}.grid{position:absolute;inset:0;background-image:linear-gradient(#59e5d311 1px,transparent 1px),linear-gradient(90deg,#59e5d311 1px,transparent 1px);background-size:90px 90px;mask-image:radial-gradient(ellipse at 50% 55%,black,transparent 74%)}.glow{position:absolute;left:20px;top:240px;width:1040px;height:1130px;border-radius:50%;background:radial-gradient(ellipse,#59e5d325,transparent 65%)}.field-ring{position:absolute;left:82px;top:605px;width:916px;height:916px;border:1px solid #59e5d326;border-radius:50%}.field-ring:before{content:'';position:absolute;inset:55px;border:1px dashed #59e5d32e;border-radius:50%}.field-ring:after{content:'';position:absolute;top:26px;left:286px;width:11px;height:11px;border-radius:50%;background:var(--teal);box-shadow:0 0 22px #59e5d3}
.brand{position:absolute;left:72px;top:43px;display:flex;gap:14px;align-items:center;font:26px Aldrich;letter-spacing:5px;color:var(--teal)}.brand-dot{width:10px;height:10px;background:var(--teal);border-radius:50%}.demo-label{position:absolute;right:72px;top:47px;font:21px Aldrich;letter-spacing:3px;color:#b2bfbc}.headline{position:absolute;left:72px;top:104px;width:936px;min-height:170px;font:76px/1.01 NanoDisplay;letter-spacing:-2px;margin:0;text-align:left}.headline span{display:block}.headline .accent{color:var(--teal)}.later{opacity:0}.footer{position:absolute;left:72px;top:1568px;width:936px;font:30px/1.25 NanoText;color:#c2d0cd;text-align:center}.chapter{position:absolute;left:77px;top:1368px;color:var(--teal);font:22px Aldrich;writing-mode:vertical-rl;transform:rotate(180deg);letter-spacing:4px}.rail{position:absolute;left:72px;bottom:27px;width:936px;height:3px;background:#59e5d326}.rail-fill{width:100%;height:3px;background:var(--teal);transform-origin:left}
.phone-wrap{position:absolute;left:250px;top:310px;width:580px;height:1223px;transform-origin:50% 50%}.phone-shell{position:absolute;inset:0;border-radius:80px;background:linear-gradient(102deg,#101816,#71807b 2%,#1a2522 3%,#080b0a 95%,#5e7069 98%,#0d1310);box-shadow:0 45px 85px #000b,0 0 80px #59e5d31c;border:2px solid #81968d66}.phone-shell:after{content:'';position:absolute;inset:6px;border:2px solid #020503;border-radius:75px}.button-side{position:absolute;left:-4px;top:220px;width:5px;height:70px;border-radius:3px;background:#64726c}.button-side.right{left:auto;right:-4px;top:290px;height:110px}.screen{position:absolute;left:14px;top:14px;width:552px;height:1195px;overflow:hidden;background:#09090b;border-radius:65px;border:1px solid #31413b}.notch{position:absolute;left:177px;top:14px;width:226px;height:38px;background:#050706;border-radius:0 0 26px 26px;z-index:9}.speaker{position:absolute;left:245px;top:25px;width:76px;height:7px;border-radius:10px;background:#1b2722;z-index:10}.camera{position:absolute;left:340px;top:22px;width:13px;height:13px;border-radius:50%;background:#152322;box-shadow:inset 0 0 0 3px #080c0b;z-index:10}.home-bar{position:absolute;bottom:22px;left:191px;width:198px;height:6px;border-radius:10px;background:#e5f2ed;z-index:10}
.page{position:absolute;inset:0;background:#09090b;overflow:hidden}.app-grid{background-color:#09090b;background-image:linear-gradient(#59e5d30a 1px,transparent 1px),linear-gradient(90deg,#59e5d30a 1px,transparent 1px);background-size:34px 34px}.status{height:72px;display:flex;align-items:center;justify-content:space-between;padding:4px 38px 0;font:23px NanoDisplay}.status-right{font:18px NanoDisplay;letter-spacing:3px}.home-content{padding:0 26px}.greeting{display:flex;justify-content:space-between;align-items:center;margin:1px 0 18px}.greeting small{font:19px Aldrich;color:#a1a1aa;letter-spacing:2px}.greeting strong{font:37px NanoDisplay;letter-spacing:1px;display:block;margin:5px 0}.streak{font:19px Aldrich;color:var(--muted);text-align:right}.streak b{color:var(--ink);font:28px NanoDisplay;display:block;margin:5px 0}.streak b span{color:#fb7716}.week{height:94px;display:flex;justify-content:space-around;padding:10px 6px;border:1.5px solid #59e5d352;border-radius:22px;background:#59e5d30b}.day{text-align:center;font:17px NanoDisplay;color:var(--muted)}.day i{display:flex;width:40px;height:40px;margin-top:8px;border-radius:50%;border:2px solid #59e5d333;align-items:center;justify-content:center;font-style:normal;color:var(--teal);font-size:23px}.day.done i{background:#59e5d32d;border-color:#59e5d360}.day.today{color:var(--teal)}.day.today i{border:3px solid var(--teal)}
.hero-creature{height:380px;position:relative;display:flex;align-items:center;flex-direction:column;justify-content:center}.creature-ring{position:absolute;top:23px;left:81px;width:338px;height:338px;transform:rotate(135deg)}.creature-ring circle{fill:none;stroke-width:13}.ring-base{stroke:#27292b}.ring-fill{stroke:var(--teal);stroke-linecap:round;stroke-dasharray:740 1000;stroke-dashoffset:0}.sprite{background-repeat:no-repeat;image-rendering:auto}.home-sprite{width:290px;height:290px;background-image:url('assets/glitchlet-idle-sheet.png');background-size:2610px 2610px;position:relative;margin-top:7px}.stage-tag{position:absolute;bottom:25px;letter-spacing:2px;font:16px Aldrich;color:var(--muted);background:#09090b;padding:5px 20px}.creature-name{text-align:center;font:30px NanoDisplay;margin-top:-12px}.evolution-remaining{text-align:center;margin:10px auto 0;font:18px Aldrich;color:var(--teal)}.steps{margin-top:25px;text-align:center}.steps label{font:19px Aldrich;letter-spacing:3px;color:var(--teal)}.step-number{font:66px SpaceMono;letter-spacing:-3px;margin-top:7px}.step-number small{font:27px Aldrich;color:var(--muted);letter-spacing:0}.progress{width:100%;height:11px;border:1px solid #59e5d350;background:#59e5d312;border-radius:20px;overflow:hidden;margin-top:12px}.progress .fill{width:100%;height:100%;background:var(--teal);border-radius:20px;transform-origin:left}.metrics{display:flex;justify-content:space-around;background:#59e5d30a;border:1.5px solid #59e5d34d;border-radius:24px;margin-top:34px;padding:18px 0}.metric{flex:1;text-align:center}.metric + .metric{border-left:1px solid #59e5d320}.metric .ico{font-size:24px;color:var(--teal);height:27px}.metric b{display:block;font:29px SpaceMono;margin-top:4px}.metric small{display:block;font:13px Aldrich;letter-spacing:1.4px;color:var(--muted);margin-top:5px}.nav{position:absolute;bottom:28px;left:17px;right:17px;height:81px;border:1px solid #59e5d34d;background:#141719;border-radius:48px;display:flex;align-items:center;justify-content:space-around;padding:0 8px}.nav div{width:84px;font:17px NanoText;text-align:center;color:var(--muted)}.nav .nav-symbol{display:block;font:29px NanoDisplay;line-height:31px;margin-bottom:5px}.nav .selected{color:var(--teal)}.nav .walk{border:3px solid var(--teal);background:#398f86;color:var(--ink);width:73px;height:73px;border-radius:50%;margin-top:-37px;display:flex;align-items:center;justify-content:center}.walk svg{width:39px;height:39px}
#evolution-page{display:flex;align-items:center;flex-direction:column;padding:130px 26px 50px;background:radial-gradient(ellipse at 50% 52%,#14342e,#09090b 65%)}.evolution-kicker{font:23px Aldrich;letter-spacing:4px;color:var(--teal);margin-top:62px}.evolution-title{font:42px NanoDisplay;text-align:center;line-height:1.1;margin-top:20px}.evolution-portal{width:435px;height:435px;border:2px solid #59e5d350;border-radius:50%;position:absolute;top:360px;box-shadow:0 0 80px #59e5d31a,inset 0 0 60px #59e5d30e}.evolution-sprite{position:absolute;top:335px;left:22px;width:506px;height:506px;background-image:url('assets/evolution-sheet.png');background-size:4554px 4554px}.evolved-name{position:absolute;top:866px;left:0;width:100%;text-align:center}.evolved-name strong{font:49px NanoDisplay;display:block}.evolved-name span{font:20px Aldrich;color:var(--teal);letter-spacing:2px;display:block;margin-top:15px}.evolve-copy{position:absolute;bottom:136px;left:46px;right:46px;font:23px/1.4 NanoText;color:#b8c9c2;text-align:center}
#route-page{background:#080a09}.route-caption{position:absolute;bottom:104px;width:100%;text-align:center;font:21px Aldrich;color:var(--teal);letter-spacing:2px}.route-video{position:absolute;left:264px;top:405px;width:552px;height:981.333px;object-fit:contain;border-radius:0;z-index:4;background:#080a09;opacity:0}
.dex-content{padding:0 24px}.dex-content h2{font:37px Aldrich;letter-spacing:3px;margin:15px 0 8px}.dex-subtitle{font:20px Aldrich;color:var(--muted);margin-bottom:28px}.catalog{border:1.5px solid #59e5d355;border-radius:28px;background:linear-gradient(125deg,#59e5d321,#18181b 78%);padding:24px}.catalog label{font:19px Aldrich;color:var(--teal);letter-spacing:2px}.catalog strong{font:37px Aldrich;display:block;margin:8px 0 19px}.catalog-stats{display:flex;gap:12px}.catalog-stats div{flex:1;padding:11px 14px;background:#ffffff04;border:1px solid #ffffff10;border-radius:17px;display:flex;align-items:center;justify-content:space-between}.catalog-stats small{font:14px Aldrich;color:var(--muted)}.catalog-stats b{font:26px Aldrich}.catalog-stats div:first-child b{color:var(--teal)}.catalog .progress{height:9px;margin-top:18px}.catalog .fill{width:25%}.specimen-label{display:flex;align-items:center;justify-content:space-between;margin:27px 0 20px;font:18px Aldrich;letter-spacing:1px}.found-pill{font:15px Aldrich;background:#59e5d315;color:var(--teal);padding:12px;border-radius:13px;border:1px solid #59e5d350}.specimens{display:grid;grid-template-columns:1fr 1fr;gap:14px}.specimen{height:239px;border:1px solid #59e5d355;background:#18181b;border-radius:27px;overflow:hidden}.specimen .id-row{display:flex;justify-content:space-between;background:#59e5d31a;padding:12px 16px;font:15px Aldrich;color:var(--muted)}.specimen .id-row span:last-child{color:var(--teal)}.specimen img{width:100%;height:146px;object-fit:contain;display:block;padding:10px}.specimen strong{font:22px NanoDisplay;text-align:center;display:block}.specimen small{display:block;text-align:center;font:12px Aldrich;margin-top:4px;color:var(--muted)}
.reward{position:absolute;right:65px;top:1120px;width:366px;min-height:290px;z-index:12;display:flex;flex-direction:column;align-items:center;padding:12px 20px 26px;border-radius:33px;background:#141c1bea;border:1.5px solid #59e5d376;box-shadow:0 24px 70px #000a}.reward img{width:150px;height:150px;object-fit:contain}.reward small{font:17px Aldrich;color:var(--teal);letter-spacing:2px;margin:1px 0 12px}.reward strong{font:31px NanoDisplay;line-height:1.1}.reward .reward-copy{font:18px NanoText;color:#bed0c9;margin-top:10px}
.corner{position:absolute;width:35px;height:35px;border-top:2px solid #59e5d35c;border-left:2px solid #59e5d35c;top:334px;left:137px}.corner.bottom{transform:rotate(180deg);top:1465px;left:auto;right:137px}
.nav-symbol svg{width:29px;height:29px;display:block;margin:auto}.ico svg{width:25px;height:25px}.streak b svg{width:23px;height:26px;vertical-align:bottom}

/* Stats uses the same current-app hierarchy as the Home and Dex demo views. */
.stats-viewport{position:absolute;left:0;top:72px;bottom:126px;width:552px;overflow:hidden;mask-image:linear-gradient(to bottom,transparent,black 12px,black calc(100% - 14px),transparent)}
.stats-scroll{width:100%;padding:8px 25px 25px;display:flex;flex-direction:column;gap:24px}
.stats-title{font:37px Aldrich;letter-spacing:2.2px;margin:0 0 8px}.stats-subtitle{font:18px Aldrich;color:var(--muted)}
.history-card{padding:24px;border:1.5px solid #59e5d369;border-radius:30px;background:linear-gradient(125deg,#59e5d323,#18181b 80%)}.history-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.history-head label{font:17px Aldrich;letter-spacing:2px;color:var(--teal)}.history-total{font:54px Aldrich;margin:11px 0;line-height:1.05;font-variant-numeric:tabular-nums}.history-head small{font:14px Aldrich;color:var(--muted);letter-spacing:1.1px}.history-icon{flex-shrink:0;width:74px;height:74px;padding:18px;background:#59e5d311;border:1.5px solid #59e5d369;border-radius:24px;color:var(--teal)}.history-icon svg{width:100%;height:100%}.history-metrics{display:flex;gap:18px;padding:22px 0;border-top:1px solid #59e5d335;border-bottom:1px solid #59e5d335;margin-top:23px}.history-metric{flex:1;display:flex;gap:12px;align-items:center}.history-metric+.history-metric{border-left:1px solid #59e5d345;padding-left:17px}.history-metric svg{width:27px;height:27px;flex-shrink:0;color:var(--teal)}.history-metric b{font:28px Aldrich;white-space:nowrap}.history-metric b small{font:14px Aldrich;color:var(--muted)}.history-metric label{font:11px Aldrich;letter-spacing:.8px;color:#a1a1aa;display:block;margin-top:4px}.badge-meter{margin-top:21px}.badge-meter .meter-label{display:flex;justify-content:space-between;font:15px Aldrich;letter-spacing:1px;color:var(--muted)}.badge-meter .meter-label span:last-child{color:var(--teal)}.badge-meter .progress{height:9px;margin-top:11px}.badge-meter .fill{width:42.1875%}
.consistency-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font:19px Aldrich;letter-spacing:.8px}.month-switch{display:flex;align-items:center;border:1px solid #33383a;background:#18181b;padding:4px;border-radius:26px;font:14px Aldrich;letter-spacing:0}.month-switch span{padding:12px 14px;color:var(--muted)}.month-switch .on{color:#09090b;background:var(--teal);border-radius:23px}
.calendar-card{border:1.5px solid #59e5d343;background:#18181b;border-radius:30px;padding:23px}.month-name{display:flex;align-items:center;justify-content:space-between;font:27px Aldrich;margin-bottom:22px}.month-arrow{display:flex;align-items:center;justify-content:center;background:#242527;width:39px;height:39px;border-radius:12px;font:32px NanoText}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}.calendar-weekday{font:15px Aldrich;color:var(--teal);text-align:center;padding-bottom:8px}.calendar-cell{height:58px;border-radius:14px;border:1px solid #59e5d355;background:#59e5d321;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transform-origin:center}.calendar-cell b{font:20px Aldrich}.calendar-cell small{font:12px Aldrich;color:var(--teal)}.calendar-cell.hit{background:var(--teal);border-color:var(--teal);color:#09090b}.calendar-cell.hit small{color:#12312d}.calendar-cell.medium{background:#59e5d34d}.calendar-blank{height:58px}
.insights-card{padding:24px;border:1.5px solid #59e5d363;border-radius:30px;background:linear-gradient(120deg,#59e5d313,#18181b 85%)}.insights-head{display:flex;justify-content:space-between;align-items:center}.insights-head h3{font:29px Aldrich;margin:0 0 7px}.insights-head p{font:14px/1.45 NanoText;color:var(--muted);margin:0}.insights-chevron{display:grid;place-items:center;width:41px;height:41px;border:1px solid #59e5d349;border-radius:50%;color:var(--teal);background:#59e5d317;font:27px NanoText}.insight-range{display:flex;gap:5px;padding:4px;background:#09090bbb;border:1px solid #353639;border-radius:28px;margin-top:23px}.insight-range span{flex:1;padding:14px 0;text-align:center;font:15px Aldrich;color:var(--muted)}.insight-range .on{background:var(--teal);border-radius:24px;color:#09090b}.average{margin-top:23px}.average label{display:block;font:15px Aldrich;letter-spacing:1px;color:var(--muted)}.average strong{font:55px Aldrich;display:inline-block;margin:7px 0 5px;font-variant-numeric:tabular-nums}.average em{font:19px Aldrich;font-style:normal;color:var(--muted);margin-left:8px}.average small{display:block;font:13px NanoText;color:var(--muted)}
.insight-chart{position:relative;margin-top:25px;padding-left:32px;height:260px}.chart-axis{position:absolute;left:0;top:0;height:224px;width:27px;display:flex;flex-direction:column;justify-content:space-between;font:12px Aldrich;color:#a1a1aa}.chart-plot{position:relative;width:100%;height:224px;border-bottom:1px solid #59676066}.chart-grid{position:absolute;inset:0;background:repeating-linear-gradient(to top,transparent 0,transparent 110px,#ffffff0c 111px,#ffffff0c 112px)}.insight-bars{display:flex;justify-content:space-around;align-items:flex-end;width:100%;height:100%;gap:14px;padding:0 8px}.insight-bar{width:36px;flex-shrink:0;border-radius:5px 5px 0 0;background:var(--teal);transform-origin:bottom}.insight-bar.under{background:#59e5d36b}.goal-rule{position:absolute;left:0;right:0;bottom:124.444px;border-top:1.5px dashed #fb7716d9;transform-origin:left}.goal-rule span{position:absolute;right:2px;top:-23px;color:#ffa669;font:11px Aldrich;background:#18181b;padding-left:4px}.chart-days{display:flex;justify-content:space-around;margin-top:10px;font:13px Aldrich;color:#a1a1aa}.insight-comparison{display:flex;gap:12px;align-items:flex-start;margin-top:24px}.insight-comparison .arrow{color:var(--teal);background:#59e5d31e;border-radius:50%;width:36px;height:36px;display:grid;place-items:center;flex-shrink:0;font:26px NanoText}.insight-comparison p{font:18px/1.5 NanoText;margin:0}.insight-metrics{display:flex;gap:12px;margin-top:24px}.insight-metric{flex:1;border:1px solid #303333;background:#09090b88;border-radius:20px;padding:18px 15px}.insight-metric label{display:block;font:13px Aldrich;letter-spacing:.7px;color:var(--muted)}.insight-metric strong{font:29px Aldrich;display:block;margin:10px 0}.insight-metric small{font:12px/1.45 NanoText;display:block;color:var(--muted)}.best-day{display:flex;gap:11px;font:15px NanoText;color:#b5babe;margin-top:23px}.best-day span{color:#fb9b3c}.stats-status{position:absolute;top:0;left:0;right:0;background:#09090b;z-index:2}.stats-note{font:17px Aldrich;letter-spacing:1.5px;color:var(--teal);padding:3px 0 12px}

</style>
</head>
<body><div id="root" data-composition-id="main" data-width="1080" data-height="1666" data-start="0" data-duration="27" data-fps="30">
<div id="background" class="ground clip" data-start="0" data-duration="27" data-track-index="0"></div><div class="grid"></div><div class="glow"></div><div class="field-ring" data-layout-allow-overflow></div><div class="corner"></div><div class="corner bottom"></div>
<div class="brand"><span class="brand-dot"></span>NANOBEASTS</div><div class="demo-label">FIELD DEMO</div>
<h1 id="h1" class="headline" data-layout-allow-overlap><span>Your steps bring</span><span class="accent">creatures to life.</span></h1>
<h1 id="h2" class="headline later" data-layout-allow-overlap><span>They evolve</span><span class="accent">as you grow.</span></h1>
<h1 id="h3" class="headline later" data-layout-allow-overlap><span>Explore more</span><span class="accent">with every walk.</span></h1>
<h1 id="h4" class="headline later" data-layout-allow-overlap><span>Make progress</span><span class="accent">you can see.</span></h1>
<h1 id="hstats" class="headline later" data-layout-allow-overlap><span>Reach your goals</span><span class="accent">with personalized insights.</span></h1>
<div class="phone-wrap" id="phone">
 <div class="phone-shell"></div><div class="button-side"></div><div class="button-side right"></div>
 <div class="screen">
  <div class="page app-grid" id="home-page">
   <div class="status" data-layout-allow-overlap><span>9:41</span><span class="status-right">▮▮▮ ▰</span></div>
   <div class="home-content">
    <div class="greeting"><div><small>Good morning,</small><strong>SINATRA</strong><small>Let's evolve today.</small></div><div class="streak">STREAK<b><span><svg viewBox="0 0 32 32" fill="currentColor"><path d="M18 1c3 7-3 10-1 15 2-1 4-4 4-7 8 7 10 17 2 21-8 4-19-1-18-10 0-5 4-10 6-13-1 7 2 10 3 10-2-6 4-9 4-16Z"/></svg></span> 4 DAYS</b></div></div>
    <div class="week"><div class="day done">M<i>✓</i></div><div class="day done">T<i>✓</i></div><div class="day done">W<i>✓</i></div><div class="day done">T<i>✓</i></div><div class="day today">F<i></i></div><div class="day">S<i></i></div><div class="day">S<i></i></div></div>
    <div class="hero-creature"><svg class="creature-ring" viewBox="0 0 360 360"><circle class="ring-base" cx="180" cy="180" r="163" stroke-dasharray="768 1024"/><circle id="ring-progress" class="ring-fill" cx="180" cy="180" r="163"/></svg><div class="sprite home-sprite" id="idle-sprite"></div><div class="stage-tag">STAGE 1</div></div>
    <div class="creature-name">Glitchlet</div><div class="evolution-remaining" id="remaining">320 TO EVOLVE</div>
    <div class="steps"><label>TODAY’S STEPS</label><div class="step-number"><span id="steps">4,680</span> <small>/ 5,000</small></div><div class="progress"><div class="fill" id="steps-fill"></div></div></div>
