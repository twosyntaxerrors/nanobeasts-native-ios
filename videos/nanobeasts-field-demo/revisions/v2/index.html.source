</div>
<video id="route-video" class="route-video clip" src="assets/route-replay.mp4" data-start="9" data-duration="6" data-track-index="4" muted playsinline></video>
<div id="reward" class="reward later" data-layout-allow-overlap><img id="reward-art" src="assets/streak-5.png" alt="Five-day streak badge"><small>ACHIEVEMENT UNLOCKED</small><strong>5-day walking streak</strong><div class="reward-copy">Keep your momentum going.</div></div>
<div id="f1" class="footer" data-layout-allow-overlap>Walk toward your next evolution.</div><div id="f2" class="footer later" data-layout-allow-overlap>Reach your step milestones. Meet a new form.</div><div id="f3" class="footer later" data-layout-allow-overlap>Track your walk. Watch your route clear the fog.</div><div id="f4" class="footer later" data-layout-allow-overlap>Build your collection with every step.</div>
<div id="fstats" class="footer later" data-layout-allow-overlap>See your trends and daily goal history.</div>
<div class="chapter" id="chapter">01 / WALK</div><div class="rail"><div class="rail-fill" id="rail-fill"></div></div>
</div>
<script>
window.__timelines=window.__timelines||{};
const tl=gsap.timeline({paused:true});
const counter={steps:4680};
function drawSteps(){let v=Math.round(counter.steps);document.getElementById('steps').textContent=v.toLocaleString('en-US');document.getElementById('remaining').textContent=v>=5000?'READY TO EVOLVE':`${5000-v} TO EVOLVE`;}
const idle={frame:0},evo={frame:0};
function sprite(id,value,size){let n=Math.max(0,Math.min(80,Math.floor(value)));document.getElementById(id).style.backgroundPosition=`-${(n%9)*size}px -${Math.floor(n/9)*size}px`;}
tl.to('.field-ring',{rotation:360,duration:27,ease:'none'},0);
tl.fromTo('.glow',{scale:.95,opacity:.75},{scale:1.12,opacity:1,duration:13.5,yoyo:true,repeat:1,ease:'sine.inOut'},0);
tl.fromTo('#rail-fill',{scaleX:0},{scaleX:1,duration:26.25,ease:'none'},0);
tl.to(counter,{steps:5000,duration:3.05,ease:'power1.inOut',onUpdate:drawSteps},.35);
tl.fromTo('#steps-fill',{scaleX:.936},{scaleX:1,duration:3.05,ease:'power1.inOut'},.35);
tl.to('#ring-progress',{attr:{'stroke-dasharray':'768 1024'},duration:3.05,ease:'power1.inOut'},.35);
tl.to(idle,{frame:80,duration:2.7,ease:'none',repeat:1,onUpdate:()=>sprite('idle-sprite',idle.frame,290)},0);
tl.fromTo('#phone',{rotation:-2,x:-10},{rotation:0,x:0,duration:4.3,ease:'sine.inOut'},0);
function exchange(oldPage,newPage,oldTitle,newTitle,oldFooter,newFooter,t){tl.to(oldPage,{opacity:0,duration:.38,ease:'power2.inOut'},t);tl.fromTo(newPage,{opacity:0},{opacity:1,duration:.38,ease:'power2.inOut',immediateRender:false},t);tl.to([oldTitle,oldFooter],{opacity:0,y:-12,duration:.3,ease:'power2.inOut'},t);tl.fromTo([newTitle,newFooter],{opacity:0,y:18},{opacity:1,y:0,duration:.38,ease:'power3.out',immediateRender:false},t+.04);}
exchange('#home-page','#evolution-page','#h1','#h2','#f1','#f2',4.3);
tl.to(evo,{frame:80,duration:2.7,ease:'none',onUpdate:()=>sprite('evo-sprite',evo.frame,506)},4.9);
tl.fromTo('#portal',{scale:.85,opacity:.3},{scale:1.08,opacity:1,duration:2.7,ease:'sine.inOut'},4.9);
tl.fromTo('#evolved-name',{opacity:0,y:26},{opacity:1,y:0,duration:.45,ease:'back.out(1.2)'},7.5);
tl.to('.evolution-title',{opacity:0,duration:.3},7.3);
exchange('#evolution-page','#route-page','#h2','#h3','#f2','#f3',9);
tl.fromTo('#route-video',{opacity:0},{opacity:1,duration:.38,ease:'power2.inOut'},9);
exchange('#route-page','#stats-page','#h3','#hstats','#f3','#fstats',14.65);
exchange('#stats-page','#dex-page','#hstats','#h4','#fstats','#f4',21.65);
tl.to('#route-video',{opacity:0,duration:.35,ease:'power2.inOut'},14.65);
tl.fromTo('.specimen',{y:35,opacity:0},{y:0,opacity:1,duration:.5,stagger:.13,ease:'power3.out'},22);
tl.fromTo('#reward',{opacity:0,x:40,y:22,scale:.9},{opacity:1,x:0,y:0,scale:1,duration:.55,ease:'back.out(1.3)'},23.7);
tl.fromTo('#reward-art',{rotationY:-100,scale:.82},{rotationY:0,scale:1,duration:.8,ease:'power3.out'},23.75);
exchange('#dex-page','#home-page','#h4','#h1','#f4','#f1',26.25);
tl.to('#reward',{opacity:0,x:30,duration:.45,ease:'power2.inOut'},26.25);
tl.to(counter,{steps:4680,duration:0,onUpdate:drawSteps},26.25);
tl.to('#steps-fill',{scaleX:.936,duration:0},26.25);
tl.to(idle,{frame:0,duration:0,onUpdate:()=>sprite('idle-sprite',idle.frame,290)},26.25);
tl.to('#ring-progress',{attr:{'stroke-dasharray':'740 1000'},duration:0},26.25);
tl.to('#phone',{rotation:-2,x:-10,duration:.75,ease:'sine.inOut'},26.25);
tl.to('#rail-fill',{scaleX:0,duration:.65,ease:'power2.inOut'},26.35);
const chapter={n:1};tl.to(chapter,{n:2,duration:0},4.3);tl.to(chapter,{n:3,duration:0},9);tl.to(chapter,{n:4,duration:0},14.65);tl.to(chapter,{n:5,duration:0},21.65);tl.to(chapter,{n:1,duration:0},26.25);
tl.eventCallback('onUpdate',()=>{const names=['','01 / WALK','02 / EVOLVE','03 / EXPLORE','04 / INSIGHTS','05 / COLLECT'];document.getElementById('chapter').textContent=names[Math.round(chapter.n)];});

const insightOffset=document.getElementById('insights-card').offsetTop-10;
const movement={total:118420,average:4900};
const updateMovement=()=>{document.getElementById('history-total').textContent=Math.round(movement.total).toLocaleString('en-US');document.getElementById('average-steps').textContent=Math.round(movement.average).toLocaleString('en-US');};
tl.to(movement,{total:135971,duration:1.25,ease:'power2.out',onUpdate:updateMovement},14.95);
tl.fromTo('#stats-badge-fill',{scaleX:0},{scaleX:1,duration:1.15,ease:'power3.out'},15.05);
tl.fromTo('.calendar-cell',{opacity:.2,scale:.9},{opacity:1,scale:1,duration:.45,stagger:.018,ease:'power2.out'},15.1);
tl.fromTo('#stats-scroll',{y:0},{y:-insightOffset,duration:1.05,ease:'power3.inOut'},17.3);
tl.to(movement,{average:6300,duration:1.1,ease:'power2.out',onUpdate:updateMovement},18.35);
tl.fromTo('.insight-bar',{scaleY:0},{scaleY:1,duration:.9,stagger:.075,ease:'power3.out'},18.35);
tl.fromTo('#goal-rule',{scaleX:0,opacity:0},{scaleX:1,opacity:1,duration:.75,ease:'power2.out'},18.6);
tl.fromTo('#insight-comparison',{opacity:0,y:16},{opacity:1,y:0,duration:.5,ease:'power3.out'},19.15);

// Once scrolled out of the viewport, retire hidden panels for contrast sampling.
tl.to(['#stats-heading','.history-card','.consistency-row','.calendar-card'],{opacity:0,duration:0},18.4);
window.__timelines.main=tl;
</script>
</body></html>
